@model FitManager.ViewModels.CompanySettingsViewModel
@{
    ViewData["Title"] = "Configuración de la Empresa";
    ViewData["BreadcrumbParent"] = "Administración";
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-building me-2 text-accent"></i>Datos de la Empresa</h1>
        <p class="text-muted mb-0">Configurá la información de tu empresa y el logotipo del sistema</p>
    </div>
</div>

<form asp-action="Settings" asp-controller="Company" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-4">

        <!-- ── Columna izquierda: Logotipo ────────────────────────────────── -->
        <div class="col-lg-4">
            <div class="card fm-card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-image me-2 text-accent"></i>Logotipo</h5>
                </div>
                <div class="card-body d-flex flex-column align-items-center text-center gap-3">

                    <!-- Preview -->
                    <div id="logoPreviewWrap"
                         class="rounded d-flex align-items-center justify-content-center"
                         style="width:180px;height:180px;background:rgba(255,255,255,.06);border:2px dashed rgba(255,255,255,.15);overflow:hidden;">
                        @if (!string.IsNullOrEmpty(Model.CurrentLogoPath))
                        {
                            <img id="logoPreview" src="/@Model.CurrentLogoPath?v=@DateTime.UtcNow.Ticks"
                                 alt="Logo" style="max-width:100%;max-height:100%;object-fit:contain;" />
                        }
                        else
                        {
                            <div id="logoPlaceholder">
                                <i class="fas fa-image fa-3x text-muted opacity-50"></i>
                                <div class="text-muted small mt-2">Sin logotipo</div>
                            </div>
                        }
                    </div>

                    <!-- File input -->
                    <div class="w-100">
                        <label asp-for="LogoFile" class="form-label small text-muted">
                            JPG, PNG, SVG, WEBP — máx. 3 MB
                        </label>
                        <input asp-for="LogoFile" type="file" class="form-control" id="logoFileInput"
                               accept=".jpg,.jpeg,.png,.gif,.svg,.webp" />
                        <span asp-validation-for="LogoFile" class="text-danger small"></span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CurrentLogoPath))
                    {
                        <form asp-action="DeleteLogo" asp-controller="Company" method="post" class="w-100" id="deleteLogoForm">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-outline-danger btn-sm w-100" id="btnDeleteLogo">
                                <i class="fas fa-trash me-1"></i>Eliminar logotipo actual
                            </button>
                        </form>
                    }

                    <div class="text-muted small">
                        El logotipo aparece en el menú lateral y en los reportes del sistema.
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Columna derecha: Datos de la empresa ───────────────────────── -->
        <div class="col-lg-8">
            <div class="card fm-card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-info-circle me-2 text-accent"></i>Información General</h5>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="row g-3">
                        <!-- Nombre -->
                        <div class="col-12">
                            <label asp-for="Name" class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Ej. GymPro Centro" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Slogan -->
                        <div class="col-12">
                            <label asp-for="Slogan" class="form-label">Slogan / Lema</label>
                            <input asp-for="Slogan" class="form-control" placeholder="Ej. Tu mejor versión, cada día" />
                        </div>

                        <!-- CUIT / RUT -->
                        <div class="col-md-6">
                            <label asp-for="TaxId" class="form-label">CUIT / RUT / NIF</label>
                            <input asp-for="TaxId" class="form-control" placeholder="Ej. 20-12345678-9" />
                        </div>

                        <!-- País -->
                        <div class="col-md-6">
                            <label asp-for="Country" class="form-label">País</label>
                            <input asp-for="Country" class="form-control" placeholder="Argentina" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card fm-card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-map-marker-alt me-2 text-accent"></i>Ubicación</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Dirección -->
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">Dirección</label>
                            <input asp-for="Address" class="form-control" placeholder="Ej. Av. Corrientes 1234, piso 2" />
                        </div>

                        <!-- Ciudad -->
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label">Ciudad</label>
                            <input asp-for="City" class="form-control" placeholder="Buenos Aires" />
                        </div>

                        <!-- Provincia -->
                        <div class="col-md-6">
                            <label asp-for="Province" class="form-label">Provincia / Estado</label>
                            <input asp-for="Province" class="form-control" placeholder="CABA" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card fm-card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-phone me-2 text-accent"></i>Contacto</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Teléfono -->
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Teléfono principal</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="+54 11 1234-5678" />
                            </div>
                        </div>

                        <!-- Teléfono 2 -->
                        <div class="col-md-6">
                            <label asp-for="Phone2" class="form-label">Teléfono alternativo</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-phone-alt"></i></span>
                                <input asp-for="Phone2" class="form-control" placeholder="+54 11 8765-4321" />
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" type="email" placeholder="info@migimnasio.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Website -->
                        <div class="col-md-6">
                            <label asp-for="Website" class="form-label">Sitio web</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-globe"></i></span>
                                <input asp-for="Website" class="form-control" placeholder="www.migimnasio.com" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card fm-card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-sticky-note me-2 text-accent"></i>Notas Internas</h5>
                </div>
                <div class="card-body">
                    <textarea asp-for="Notes" class="form-control" rows="3"
                              placeholder="Información adicional, notas internas..."></textarea>
                </div>
            </div>

            <!-- ── Recepción / Kiosco ─────────────────────────────────────────── -->
            <div class="card fm-card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fas fa-door-open text-accent fs-5"></i>
                    <h5 class="card-title mb-0">Pantalla de Recepción</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="ReceptionModalSeconds" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ReceptionModalSeconds" type="number" min="3" max="60"
                                       class="form-control" />
                                <span class="input-group-text">seg</span>
                            </div>
                            <div class="form-text">
                                Duración del modal de bienvenida en <code>/Reception</code>. Entre 3 y 60 segundos.
                            </div>
                            <span asp-validation-for="ReceptionModalSeconds" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── WhatsApp ──────────────────────────────────────────────────── -->
            <div class="card fm-card mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="fab fa-whatsapp text-success fs-5"></i>
                    <h5 class="card-title mb-0">Notificaciones por WhatsApp</h5>
                </div>
                <div class="card-body">
                    <!-- Toggle habilitado -->
                    <div class="form-check form-switch mb-3">
                        <input asp-for="WhatsAppEnabled" class="form-check-input" type="checkbox"
                               id="waEnabledSwitch" role="switch" />
                        <label class="form-check-label" for="waEnabledSwitch">
                            Habilitar envío de notificaciones por WhatsApp
                        </label>
                    </div>

                    <div id="waFields">
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="WhatsAppApiUrl" class="form-label">URL de la API</label>
                                <input asp-for="WhatsAppApiUrl" class="form-control"
                                       placeholder="https://localhost:7275" />
                                <div class="form-text">URL base de la API (ej. <code>https://localhost:7275</code>). Sin barra final.</div>
                            </div>
                            <div class="col-12">
                                <label asp-for="WhatsAppApiKey" class="form-label">API Key</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-key"></i></span>
                                    <input asp-for="WhatsAppApiKey" class="form-control" type="password"
                                           id="waApiKeyInput" placeholder="nf_xxxxxxxxxxxx" autocomplete="off" />
                                    <button type="button" class="btn btn-outline-secondary"
                                            onclick="toggleWaKey()" title="Mostrar/ocultar">
                                        <i class="fas fa-eye" id="waKeyEyeIcon"></i>
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.WhatsAppApiKey))
                                {
                                    <div class="form-text">
                                        <i class="fas fa-check-circle text-success me-1"></i>
                                        API Key configurada. Dejá el campo vacío para conservar la clave actual.
                                    </div>
                                }
                                else
                                {
                                    <div class="form-text">Ingresá tu API Key de WhatsApp.</div>
                                }
                            </div>
                        </div>

                        <!-- ── Tabla de eventos ─────────────────────────────── -->
                        <div class="mb-2">
                            <h6 class="mb-0"><i class="fas fa-bolt me-1 text-accent"></i>Eventos configurados</h6>
                            <div class="form-text">Los eventos son definidos por el sistema. Activá/desactivá cada uno y configurá el nombre del evento en tu plataforma WhatsApp.</div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-hover fm-table mb-0" id="waEventsTable">
                                <thead>
                                    <tr>
                                        <th>Descripción</th>
                                        <th>Nombre del evento (plataforma)</th>
                                        <th class="text-center">Activo</th>
                                        <th class="text-center" style="width:60px">Config.</th>
                                    </tr>
                                </thead>
                                <tbody id="waEventsTbody">
                                    @foreach (var e in Model.WhatsAppEvents)
                                    {
                                        <tr id="waRow-@e.Id">
                                            <td>@e.Label</td>
                                            <td><code id="waCode-@e.Id">@e.EventName</code></td>
                                            <td class="text-center">
                                                <span class="badge @(e.IsActive ? "bg-success" : "bg-secondary") badge-wa-status"
                                                      style="cursor:pointer" onclick="toggleWaEvent(@e.Id)"
                                                      title="Click para activar/desactivar">
                                                    @(e.IsActive ? "Sí" : "No")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-icon btn-outline-secondary"
                                                        onclick="editWaEvent(@e.Id,'@Html.Raw(e.EventName.Replace("'","\\'"))')"
                                                        title="Configurar nombre del evento">
                                                    <i class="fas fa-pencil-alt"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Modal Configurar evento ──────────────────────────────────── -->
            <div class="modal fade" id="waEventModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content" style="background:#1a1d27;border-color:#333;">
                        <div class="modal-header border-secondary">
                            <h5 class="modal-title"><i class="fab fa-whatsapp text-success me-2"></i>Configurar evento</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="waEvtId" value="0" />
                            <div class="mb-3">
                                <label class="form-label">Nombre del evento (plataforma) <span class="text-danger">*</span></label>
                                <input type="text" id="waEvtEventName" class="form-control"
                                       placeholder="Ej. pago_confirmado" />
                                <div class="form-text">Nombre exacto del evento configurado en la API de WhatsApp.</div>
                            </div>
                        </div>
                        <div class="modal-footer border-secondary">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn btn-accent" id="btnSaveWaEvent">
                                <i class="fas fa-save me-1"></i>Guardar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <button type="submit" class="btn btn-accent px-4">
                    <i class="fas fa-save me-2"></i>Guardar Configuración
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
// ── WhatsApp fields toggle ────────────────────────────────────────────────────
(function () {
    var sw     = document.getElementById('waEnabledSwitch');
    var fields = document.getElementById('waFields');
    function updateFields() { fields.style.display = sw.checked ? '' : 'none'; }
    sw.addEventListener('change', updateFields);
    updateFields();
})();

function toggleWaKey() {
    var inp  = document.getElementById('waApiKeyInput');
    var icon = document.getElementById('waKeyEyeIcon');
    if (inp.type === 'password') {
        inp.type = 'text';
        icon.className = 'fas fa-eye-slash';
    } else {
        inp.type = 'password';
        icon.className = 'fas fa-eye';
    }
}

// ── Preview de logo en tiempo real ────────────────────────────────────────────
document.getElementById('logoFileInput')?.addEventListener('change', function () {
    const file = this.files[0];
    if (!file) return;

    const wrap = document.getElementById('logoPreviewWrap');
    const reader = new FileReader();
    reader.onload = e => {
        wrap.innerHTML = `<img src="${e.target.result}" alt="Logo"
            style="max-width:100%;max-height:100%;object-fit:contain;" />`;
    };
    reader.readAsDataURL(file);
});

// ── Confirmar eliminación de logo ─────────────────────────────────────────────
document.getElementById('btnDeleteLogo')?.addEventListener('click', function () {
    Swal.fire({
        title: '¿Eliminar logotipo?',
        text: 'Se eliminará el logo actual del sistema.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: '<i class="fas fa-trash me-1"></i>Sí, eliminar',
        cancelButtonText: 'Cancelar',
        background: '#1a1d27',
        color: '#e0e0e0'
    }).then(result => {
        if (result.isConfirmed)
            document.getElementById('deleteLogoForm').submit();
    });
});

// ── Toast de éxito ────────────────────────────────────────────────────────────
@if (TempData["Success"] != null)
{
    <text>
    Swal.fire({ toast: true, position: 'top-end', icon: 'success',
        title: '@TempData["Success"]', showConfirmButton: false,
        timer: 3500, background: '#1a1d27', color: '#e0e0e0' });
    </text>
}

// ── WhatsApp events ───────────────────────────────────────────────────────────
var waModal  = new bootstrap.Modal(document.getElementById('waEventModal'));
var waEditId = 0;

function getToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]').value;
}

// ── Abrir modal para configurar nombre del evento ─────────────────────────────
function editWaEvent(id, eventName) {
    waEditId = id;
    document.getElementById('waEvtId').value        = id;
    document.getElementById('waEvtEventName').value = eventName;
    waModal.show();
}

// ── Guardar nombre del evento ─────────────────────────────────────────────────
document.getElementById('btnSaveWaEvent').addEventListener('click', async function () {
    var eventName = document.getElementById('waEvtEventName').value.trim();

    if (!eventName) {
        Swal.fire({ toast: true, position: 'top-end', icon: 'warning',
            title: 'El nombre del evento es obligatorio.',
            showConfirmButton: false, timer: 3000,
            background: '#1a1d27', color: '#e0e0e0' });
        return;
    }

    try {
        var resp = await fetch('/Company/UpdateWhatsAppEvent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json',
                       'RequestVerificationToken': getToken() },
            body: JSON.stringify({ id: waEditId, eventName })
        });
        var data = await resp.json();

        if (!data.success) {
            Swal.fire({ toast: true, position: 'top-end', icon: 'error',
                title: data.error || 'Error al guardar.', showConfirmButton: false,
                timer: 3500, background: '#1a1d27', color: '#e0e0e0' });
            return;
        }

        // Actualizar el <code> en la fila
        var code = document.getElementById('waCode-' + waEditId);
        if (code) code.textContent = eventName;

        waModal.hide();
        Swal.fire({ toast: true, position: 'top-end', icon: 'success',
            title: 'Evento actualizado.', showConfirmButton: false,
            timer: 2500, background: '#1a1d27', color: '#e0e0e0' });

    } catch (e) {
        Swal.fire({ toast: true, position: 'top-end', icon: 'error',
            title: 'Error de red.', showConfirmButton: false,
            timer: 3000, background: '#1a1d27', color: '#e0e0e0' });
    }
});

// ── Activar / desactivar evento ───────────────────────────────────────────────
async function toggleWaEvent(id) {
    try {
        var resp = await fetch('/Company/ToggleWhatsAppEvent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json',
                       'RequestVerificationToken': getToken() },
            body: JSON.stringify(id)
        });
        var data = await resp.json();
        if (!data.success) return;

        var badge = document.querySelector('#waRow-' + id + ' .badge-wa-status');
        if (!badge) return;
        var isActive = badge.textContent.trim() === 'Sí';
        badge.textContent = isActive ? 'No' : 'Sí';
        badge.className   = 'badge ' + (isActive ? 'bg-secondary' : 'bg-success') + ' badge-wa-status';
    } catch (e) { /* silencioso */ }
}
</script>
}
